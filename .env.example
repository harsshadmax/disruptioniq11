# Backend (copy to backend/.env)
# "development" allows the defaults below. Anything else (for example "production") refuses to start with a
# default or short (<16 characters) JWT_SECRET / WEBHOOK_SECRET, and refuses to seed the public demo password.
ENVIRONMENT=development
# postgres:// and postgresql:// URLs from a host are accepted; the psycopg 3 driver is added for you
DATABASE_URL=postgresql+psycopg://disruptioniq:disruptioniq@localhost:5433/disruptioniq
JWT_SECRET=change-me
# HMAC key the carrier uses to sign webhook bodies (X-Signature: sha256=<hex>)
WEBHOOK_SECRET=change-me-too
# Password given to the five demo users by `python -m app.seed_users` (required outside development)
DEMO_PASSWORD=
CORS_ORIGINS=http://localhost:3000
# Optional: AI layer works with templates when these are unset
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Frontend (copy to frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Demo only: the login page's one-click role buttons fill this password (the seeded demo users' password). Leave unset to type it.
# Anything set here is public in the browser bundle: use it only on a clearly marked demo deployment.
NEXT_PUBLIC_DEMO_PASSWORD=
